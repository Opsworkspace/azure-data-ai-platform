{
  "name": "purple-medallion-pipeline",
  "description": "Bronze to silver to gold, then rebuild the vector index. Defined as JSON and deployed by CI rather than created in the workspace UI: a job defined by clicking is a job nobody can review, reproduce in another workspace, or roll back.",
  "tags": {
    "environment": "prod",
    "workload": "data",
    "owner": "platform-team@example.com",
    "cost_center": "CC-0000-PLATFORM",
    "managed_by": "terraform"
  },
  "schedule": {
    "quartz_cron_expression": "0 0 2 * * ?",
    "timezone_id": "UTC",
    "pause_status": "UNPAUSED"
  },
  "max_concurrent_runs": 1,
  "timeout_seconds": 14400,
  "email_notifications": {
    "on_failure": ["platform-oncall@example.com"],
    "no_alert_for_skipped_runs": true
  },
  "health": {
    "rules": [
      {
        "metric": "RUN_DURATION_SECONDS",
        "op": "GREATER_THAN",
        "value": 7200
      }
    ]
  },
  "job_clusters": [
    {
      "job_cluster_key": "etl_cluster",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "Standard_D8ds_v5",
        "driver_node_type_id": "Standard_D8ds_v5",
        "num_workers": 4,
        "data_security_mode": "SINGLE_USER",
        "runtime_engine": "PHOTON",
        "azure_attributes": {
          "availability": "SPOT_WITH_FALLBACK_AZURE",
          "first_on_demand": 1,
          "spot_bid_max_price": -1
        },
        "spark_conf": {
          "spark.databricks.delta.optimizeWrite.enabled": "true",
          "spark.databricks.delta.autoCompact.enabled": "true",
          "spark.sql.shuffle.partitions": "auto"
        },
        "custom_tags": {
          "environment": "prod",
          "workload": "data",
          "pipeline": "medallion"
        }
      }
    },
    {
      "job_cluster_key": "embedding_cluster",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "Standard_D4ds_v5",
        "num_workers": 2,
        "data_security_mode": "SINGLE_USER",
        "azure_attributes": {
          "availability": "ON_DEMAND_AZURE"
        },
        "custom_tags": {
          "environment": "prod",
          "workload": "data",
          "pipeline": "embedding"
        }
      }
    }
  ],
  "tasks": [
    {
      "task_key": "bronze_ingest",
      "description": "Land raw files into bronze. Never transforms.",
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/platform/azure-data-ai-platform/data/databricks/notebooks/01_bronze_ingest",
        "base_parameters": {
          "catalog": "purple_prod",
          "table_name": "raw_uploads"
        }
      },
      "timeout_seconds": 3600,
      "max_retries": 3,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": false
    },
    {
      "task_key": "silver_transform",
      "description": "Clean, deduplicate and conform. Quarantines bad rows rather than dropping them.",
      "depends_on": [{ "task_key": "bronze_ingest" }],
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/platform/azure-data-ai-platform/data/databricks/notebooks/02_silver_transform",
        "base_parameters": { "catalog": "purple_prod" }
      },
      "timeout_seconds": 5400,
      "max_retries": 2,
      "min_retry_interval_millis": 120000
    },
    {
      "task_key": "gold_aggregate",
      "description": "Build the business aggregates the API and dashboards read.",
      "depends_on": [{ "task_key": "silver_transform" }],
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/platform/azure-data-ai-platform/data/databricks/notebooks/03_gold_aggregate",
        "base_parameters": { "catalog": "purple_prod" }
      },
      "timeout_seconds": 3600,
      "max_retries": 2
    },
    {
      "task_key": "build_vector_index",
      "description": "Chunk, embed and index. Runs on its own cluster so a long embedding run does not hold the larger ETL cluster.",
      "depends_on": [{ "task_key": "gold_aggregate" }],
      "job_cluster_key": "embedding_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/platform/azure-data-ai-platform/data/databricks/notebooks/04_build_vector_index",
        "base_parameters": {
          "catalog": "purple_prod",
          "index_name": "purple-documents"
        }
      },
      "timeout_seconds": 7200,
      "max_retries": 1
    }
  ]
}
